{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Obsolete. Claude Code no longer has a TodoWrite tool; see TaskCreate and TaskUpdate.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "PreToolUse"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_input": {
      "type": "object",
      "properties": {
        "todos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ]
              },
              "priority": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "content",
              "status",
              "priority",
              "id"
            ]
          }
        }
      },
      "required": [
        "todos"
      ]
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "tool_name",
    "tool_input"
  ],
  "title": "TodoWrite PreToolUse Schema (obsolete)",
  "description": "JSON Schema for TodoWrite tool PreToolUse events"
}
