{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent PostToolUse Schema",
  "description": "JSON Schema for Agent tool PostToolUse events, derived from captured payloads",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string",
      "description": "UUID of the user prompt being processed; absent before the first prompt"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "permission_mode": {
      "type": "string",
      "description": "default, plan, acceptEdits, auto, dontAsk or bypassPermissions"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "description": "low, medium, high, xhigh or max"
        }
      }
    },
    "agent_id": {
      "type": "string",
      "description": "Present when the call is made inside a subagent"
    },
    "agent_type": {
      "type": "string",
      "description": "Present inside a subagent, or in a session started with --agent"
    },
    "hook_event_name": {
      "const": "PostToolUse"
    },
    "tool_name": {
      "const": "Agent"
    },
    "tool_use_id": {
      "type": "string"
    },
    "tool_input": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "run_in_background": {
          "type": "boolean"
        },
        "subagent_type": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "prompt",
        "subagent_type"
      ]
    },
    "tool_response": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "agentType": {
          "type": "string"
        },
        "canContinueAgent": {
          "type": "boolean"
        },
        "canReadOutputFile": {
          "type": "boolean"
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "description": {
          "type": "string"
        },
        "handback": {
          "type": "string"
        },
        "handbackReport": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "harnessNoteCount": {
          "type": "number"
        },
        "harnessSectionHash": {
          "type": "string"
        },
        "harnessTailCount": {
          "type": "number"
        },
        "isAsync": {
          "type": "boolean"
        },
        "outputFile": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "resolvedModel": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "toolStats": {
          "type": "object",
          "properties": {
            "bashCount": {
              "type": "number"
            },
            "editFileCount": {
              "type": "number"
            },
            "linesAdded": {
              "type": "number"
            },
            "linesRemoved": {
              "type": "number"
            },
            "otherToolCount": {
              "type": "number"
            },
            "readCount": {
              "type": "number"
            },
            "searchCount": {
              "type": "number"
            }
          }
        },
        "toolsUsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalDurationMs": {
          "type": "number"
        },
        "totalTokens": {
          "type": "number"
        },
        "totalToolUseCount": {
          "type": "number"
        },
        "usage": {
          "type": "object",
          "properties": {
            "cache_creation": {
              "type": "object",
              "properties": {
                "ephemeral_1h_input_tokens": {
                  "type": "number"
                },
                "ephemeral_5m_input_tokens": {
                  "type": "number"
                }
              }
            },
            "cache_creation_input_tokens": {
              "type": "number"
            },
            "cache_read_input_tokens": {
              "type": "number"
            },
            "fallback_credit": {},
            "inference_geo": {
              "type": "string"
            },
            "input_tokens": {
              "type": "number"
            },
            "iterations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "output_tokens": {
              "type": "number"
            },
            "output_tokens_details": {
              "type": "object",
              "properties": {
                "thinking_tokens": {
                  "type": "number"
                }
              }
            },
            "server_tool_use": {
              "type": "object",
              "properties": {
                "web_fetch_requests": {
                  "type": "number"
                },
                "web_search_requests": {
                  "type": "number"
                }
              }
            },
            "service_tier": {
              "type": "string"
            },
            "speed": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "agentId",
        "canContinueAgent",
        "prompt",
        "resolvedModel",
        "status"
      ]
    },
    "duration_ms": {
      "type": "number"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "tool_name",
    "tool_input",
    "tool_use_id",
    "tool_response"
  ]
}
