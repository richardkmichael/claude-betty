{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Obsolete. Claude Code no longer has a NotebookRead tool; Read reads notebooks.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "PreToolUse"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_input": {
      "type": "object",
      "properties": {
        "notebook_path": {
          "type": "string"
        },
        "cell_id": {
          "type": "string"
        }
      },
      "required": [
        "notebook_path"
      ]
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "tool_name",
    "tool_input"
  ],
  "title": "NotebookRead PreToolUse Schema (obsolete)",
  "description": "JSON Schema for NotebookRead tool PreToolUse events"
}
