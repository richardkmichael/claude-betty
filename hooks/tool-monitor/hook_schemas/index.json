{
  "title": "Claude Code Tool Hook Schemas",
  "description": "JSON Schema files for Claude Code tool hook payloads.  Schemas marked obsolete describe tools Claude Code no longer has, and are kept for older payloads.",
  "version": "3.0.0",
  "naming_convention": "{toolname}-{hook_event}.json, with hook_event one of pre_tool_use, post_tool_use, post_tool_use_failure, permission_request",
  "validation_tool": "uvx check-jsonschema",
  "schemas": {
    "Agent": {
      "category": "Workflow",
      "analysis_fields": [
        "$.tool_input.description",
        "$.tool_input.subagent_type"
      ],
      "files": {
        "pre_tool_use": "agent-pre_tool_use.json",
        "post_tool_use": "agent-post_tool_use.json",
        "post_tool_use_failure": "agent-post_tool_use_failure.json",
        "permission_request": "agent-permission_request.json"
      }
    },
    "Bash": {
      "category": "System",
      "analysis_fields": [
        "$.tool_input.command",
        "$.tool_input.description"
      ],
      "files": {
        "pre_tool_use": "bash-pre_tool_use.json",
        "post_tool_use": "bash-post_tool_use.json",
        "post_tool_use_failure": "bash-post_tool_use_failure.json",
        "permission_request": "bash-permission_request.json"
      }
    },
    "Edit": {
      "category": "File",
      "analysis_fields": [
        "$.tool_input.file_path",
        "$.tool_input.old_string",
        "$.tool_input.new_string"
      ],
      "files": {
        "pre_tool_use": "edit-pre_tool_use.json",
        "post_tool_use": "edit-post_tool_use.json",
        "post_tool_use_failure": "edit-post_tool_use_failure.json",
        "permission_request": "edit-permission_request.json"
      }
    },
    "ExitPlanMode": {
      "category": "Workflow",
      "analysis_fields": [],
      "files": {
        "pre_tool_use": "exitplanmode-pre_tool_use.json",
        "post_tool_use": "exitplanmode-post_tool_use.json",
        "post_tool_use_failure": "exitplanmode-post_tool_use_failure.json",
        "permission_request": "exitplanmode-permission_request.json"
      }
    },
    "Glob": {
      "category": "Search",
      "analysis_fields": [
        "$.tool_input.pattern",
        "$.tool_input.path"
      ],
      "files": {
        "pre_tool_use": "glob-pre_tool_use.json",
        "post_tool_use": "glob-post_tool_use.json",
        "post_tool_use_failure": "glob-post_tool_use_failure.json",
        "permission_request": "glob-permission_request.json"
      }
    },
    "Grep": {
      "category": "Search",
      "analysis_fields": [
        "$.tool_input.pattern",
        "$.tool_input.output_mode"
      ],
      "files": {
        "pre_tool_use": "grep-pre_tool_use.json",
        "post_tool_use": "grep-post_tool_use.json",
        "post_tool_use_failure": "grep-post_tool_use_failure.json",
        "permission_request": "grep-permission_request.json"
      }
    },
    "Monitor": {
      "category": "System",
      "analysis_fields": [
        "$.tool_input.command"
      ],
      "files": {
        "pre_tool_use": "monitor-pre_tool_use.json",
        "post_tool_use": "monitor-post_tool_use.json",
        "post_tool_use_failure": "monitor-post_tool_use_failure.json",
        "permission_request": "monitor-permission_request.json"
      }
    },
    "Read": {
      "category": "File",
      "analysis_fields": [
        "$.tool_input.file_path"
      ],
      "files": {
        "pre_tool_use": "read-pre_tool_use.json",
        "post_tool_use": "read-post_tool_use.json",
        "post_tool_use_failure": "read-post_tool_use_failure.json",
        "permission_request": "read-permission_request.json"
      }
    },
    "SendMessage": {
      "category": "Workflow",
      "analysis_fields": [
        "$.tool_input.to"
      ],
      "files": {
        "pre_tool_use": "sendmessage-pre_tool_use.json",
        "post_tool_use": "sendmessage-post_tool_use.json",
        "post_tool_use_failure": "sendmessage-post_tool_use_failure.json",
        "permission_request": "sendmessage-permission_request.json"
      }
    },
    "Skill": {
      "category": "Workflow",
      "analysis_fields": [
        "$.tool_input.skill"
      ],
      "files": {
        "pre_tool_use": "skill-pre_tool_use.json",
        "post_tool_use": "skill-post_tool_use.json",
        "post_tool_use_failure": "skill-post_tool_use_failure.json",
        "permission_request": "skill-permission_request.json"
      }
    },
    "TaskCreate": {
      "category": "Workflow",
      "analysis_fields": [
        "$.tool_input.subject"
      ],
      "files": {
        "pre_tool_use": "taskcreate-pre_tool_use.json",
        "post_tool_use": "taskcreate-post_tool_use.json",
        "post_tool_use_failure": "taskcreate-post_tool_use_failure.json",
        "permission_request": "taskcreate-permission_request.json"
      }
    },
    "TaskUpdate": {
      "category": "Workflow",
      "analysis_fields": [
        "$.tool_input.taskId"
      ],
      "files": {
        "pre_tool_use": "taskupdate-pre_tool_use.json",
        "post_tool_use": "taskupdate-post_tool_use.json",
        "post_tool_use_failure": "taskupdate-post_tool_use_failure.json",
        "permission_request": "taskupdate-permission_request.json"
      }
    },
    "ToolSearch": {
      "category": "Search",
      "analysis_fields": [
        "$.tool_input.query"
      ],
      "files": {
        "pre_tool_use": "toolsearch-pre_tool_use.json",
        "post_tool_use": "toolsearch-post_tool_use.json",
        "post_tool_use_failure": "toolsearch-post_tool_use_failure.json",
        "permission_request": "toolsearch-permission_request.json"
      }
    },
    "WebFetch": {
      "category": "Web",
      "analysis_fields": [
        "$.tool_input.url"
      ],
      "files": {
        "pre_tool_use": "webfetch-pre_tool_use.json",
        "post_tool_use": "webfetch-post_tool_use.json",
        "post_tool_use_failure": "webfetch-post_tool_use_failure.json",
        "permission_request": "webfetch-permission_request.json"
      }
    },
    "WebSearch": {
      "category": "Web",
      "analysis_fields": [
        "$.tool_input.query"
      ],
      "files": {
        "pre_tool_use": "websearch-pre_tool_use.json",
        "post_tool_use": "websearch-post_tool_use.json",
        "post_tool_use_failure": "websearch-post_tool_use_failure.json",
        "permission_request": "websearch-permission_request.json"
      }
    },
    "Write": {
      "category": "File",
      "analysis_fields": [
        "$.tool_input.file_path"
      ],
      "files": {
        "pre_tool_use": "write-pre_tool_use.json",
        "post_tool_use": "write-post_tool_use.json",
        "post_tool_use_failure": "write-post_tool_use_failure.json",
        "permission_request": "write-permission_request.json"
      }
    },
    "LS": {
      "category": "System",
      "obsolete": true,
      "note": "Claude Code no longer has an LS tool; directory listings go through Bash.",
      "analysis_fields": [],
      "files": {
        "pre_tool_use": "ls-pre_tool_use.json",
        "post_tool_use": "ls-post_tool_use.json"
      }
    },
    "MultiEdit": {
      "category": "File",
      "obsolete": true,
      "note": "Claude Code no longer has a MultiEdit tool; see Edit.",
      "analysis_fields": [],
      "files": {
        "pre_tool_use": "multiedit-pre_tool_use.json",
        "post_tool_use": "multiedit-post_tool_use.json"
      }
    },
    "NotebookRead": {
      "category": "File",
      "obsolete": true,
      "note": "Claude Code no longer has a NotebookRead tool; Read reads notebooks.",
      "analysis_fields": [],
      "files": {
        "pre_tool_use": "notebookread-pre_tool_use.json",
        "post_tool_use": "notebookread-post_tool_use.json"
      }
    },
    "TodoWrite": {
      "category": "Workflow",
      "obsolete": true,
      "note": "Claude Code no longer has a TodoWrite tool; see TaskCreate and TaskUpdate.",
      "analysis_fields": [
        "$.tool_input.todos"
      ],
      "files": {
        "pre_tool_use": "todowrite-pre_tool_use.json",
        "post_tool_use": "todowrite-post_tool_use.json"
      }
    },
    "Task": {
      "category": "Workflow",
      "obsolete": true,
      "note": "The subagent tool is recorded as Agent; see the agent-* schemas.",
      "analysis_fields": [
        "$.tool_input.description",
        "$.tool_input.subagent_type"
      ],
      "files": {
        "pre_tool_use": "task-pre_tool_use.json",
        "post_tool_use": "task-post_tool_use.json"
      }
    }
  }
}
